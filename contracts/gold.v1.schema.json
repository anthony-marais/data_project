{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presslake.local/contracts/gold.v1.schema.json",
  "title": "PressLake Gold row v1 (silver parquet)",
  "description": "Projection colonnaire d'un document silver. Écrite par Spark (module 15), pas par le poll Python. Une ligne = un article. Les chunks RAG restent dans Qdrant.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "feed_id",
    "dt",
    "content_hash",
    "title",
    "canonical_url",
    "parsed_at",
    "text",
    "text_source",
    "bronze_s3_uri",
    "feed_lang",
    "content_lang"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "feed_id": { "type": "string", "minLength": 1 },
    "dt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Partition hive dt= copiée depuis le chemin silver."
    },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": ["string", "null"] },
    "canonical_url": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "published": { "type": ["string", "null"] },
    "parsed_at": { "type": "string" },
    "text": { "type": "string", "minLength": 1 },
    "text_source": {
      "type": "string",
      "enum": ["rss_summary", "permalink", "title_only"]
    },
    "bronze_s3_uri": { "type": "string", "pattern": "^s3://" },
    "feed_lang": { "type": "string", "minLength": 2, "maxLength": 3 },
    "content_lang": { "type": "string", "minLength": 2, "maxLength": 3 },
    "content_lang_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
