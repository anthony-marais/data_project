POSTGRES_USER=xxxxxxxx
POSTGRES_PASSWORD=xxxxxxxx
POSTGRES_DB=xxxxxxxx
DATABASE_URL=postgresql://xxxxxxxx:xxxxxxxx@localhost:5432/xxxxxxxx
MINIO_ROOT_USER=xxxxxxxx
MINIO_ROOT_PASSWORD=xxxxxxxxxxxxx
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=presslake
PRESSLAKE_STALE_HOURS=6
# Hôte (uv run sur la machine) — ports exposés par docker compose
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# Compose applicatif (futur) — réseau interne : redpanda:9092, postgres:5432, http://minio:9000
OPENSEARCH_URL=http://localhost:9200
# Compose applicatif (futur) : http://opensearch:9200
QDRANT_URL=http://localhost:6333
# Compose applicatif (futur) : http://qdrant:6333

# RAG — LLM local Ollama (module 12)
OLLAMA_BASE_URL=http://localhost:11434
# CPU : llama3.2:1b — GPU AMD/NVIDIA : llama3.2 (voir scripts/setup-ollama-amd-gpu.sh)
OLLAMA_MODEL=llama3.2:1b
RAG_TOP_K=4
# Limite tokens générés (latence CPU) ; maintien modèle en RAM côté Ollama
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m
# Warmup embed + Ollama au `presslake serve` (évite ~10 s au 1er message)
PRESSLAKE_RAG_WARMUP=true
# Nom affiché dans Open WebUI / LibreChat (route /v1)
PRESSLAKE_RAG_MODEL=presslake-rag
# Optionnel — modèle fastembed (changer = ré-indexer avec presslake embed)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Ollama (service système) — GPU AMD iGPU : sudo ./scripts/setup-ollama-amd-gpu.sh
# export OLLAMA_NUM_THREADS=$(nproc)

# Open WebUI (docker compose) — http://localhost:3000
OPEN_WEBUI_PORT=3000
# URL vue depuis le conteneur Open WebUI vers PressLake sur l'hôte
PRESSLAKE_OPENAI_BASE_URL=http://host.docker.internal:8000/v1
PRESSLAKE_OPENAI_API_KEY=presslake
OPEN_WEBUI_AUTH=true
